{
  "name": "c-abstract-http",
  "version-string": "0.1.0",
  "dependencies": [
    {
      "name": "curl",
      "platform": "!windows & !osx"
    }
  ],
  "features": {
    "libuv": {
      "description": "Use libuv transport backend",
      "dependencies": [
        "libuv"
      ]
    },
    "libevent": {
      "description": "Use libevent transport backend",
      "dependencies": [
        "libevent"
      ]
    },
    "libsoup3": {
      "description": "Use libsoup3 transport backend",
      "dependencies": [
        "libsoup"
      ]
    },
    "nghttp3": {
      "description": "Use nghttp3 + ngtcp2 HTTP/3 transport backend",
      "dependencies": [
        "nghttp3",
        "ngtcp2"
      ]
    },
    "lsquic": {
      "description": "Use LiteSpeed QUIC (lsquic) HTTP/3 transport backend",
      "dependencies": [
        "lsquic"
      ]
    },
    "msh3": {
      "description": "Use Microsoft msh3 (msquic) HTTP/3 transport backend",
      "dependencies": [
        "msquic"
      ]
    },
    "mbedtls": {
      "description": "Use mbedtls for cryptography",
      "dependencies": [
        "mbedtls"
      ]
    },
    "openssl": {
      "description": "Use OpenSSL for cryptography",
      "dependencies": [
        "openssl"
      ]
    },
    "libressl": {
      "description": "Use LibreSSL for cryptography",
      "dependencies": [
        "libressl"
      ]
    },
    "boringssl": {
      "description": "Use BoringSSL for cryptography",
      "dependencies": [
        "boringssl"
      ]
    },
    "wolfssl": {
      "description": "Use wolfSSL for cryptography",
      "dependencies": [
        "wolfssl"
      ]
    },
    "s2n": {
      "description": "Use s2n-tls for cryptography",
      "dependencies": [
        "s2n"
      ]
    },
    "bearssl": {
      "description": "Use BearSSL for cryptography",
      "dependencies": [
        "bearssl"
      ]
    },
    "gnutls": {
      "description": "Use GnuTLS for cryptography",
      "dependencies": [
        "gnutls"
      ]
    },
    "botan": {
      "description": "Use Botan for cryptography",
      "dependencies": [
        "botan"
      ]
    },
    "schannel": {
      "description": "Use Schannel for cryptography (Windows Native)"
    }
  }
}
